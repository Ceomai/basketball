{
  "name": "pota-kariyeri",
  "version": "1.0.0",
  "private": true,
  "description": "İstanbul'dan NBA'e basketbol kariyer simülasyonu",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.{js,mjs}\" \"tools/**/*.js\"",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && node tests/smoke.js && node tests/balance.js 3",
    "test:balance": "npm run build && node tests/balance.js 10"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
